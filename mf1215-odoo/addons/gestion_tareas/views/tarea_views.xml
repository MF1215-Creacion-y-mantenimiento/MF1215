<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="gestion_tareas_tarea_view_list" model="ir.ui.view">
        <field name="name">gestion_tareas.tarea.list</field>
        <field name="model">gestion_tareas.tarea</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="fecha" />
                <field name="state" widget="badge" decoration-warning="state == 'pendiente'"
                    decoration-success="state == 'finalizada'" />
            </list>
        </field>
    </record>
    <!-- Vista de formulario -->
    <record id="gestion_tareas_tarea_view_form" model="ir.ui.view">
        <field name="name">gestion_tareas.tarea.form</field>
        <field name="model">gestion_tareas.tarea</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_finalizar" type="object" string="Finalizar"
                        class="btn-primary" />
                    <field name="state" widget="statusbar" statusbar_visible="pendiente,finalizada" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la tarea" />
                        </h1>
                    </div>
                    <group>
                        <field name="partner_id" />
                        <field name="fecha" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Vista de búsqueda -->
    <record id="gestion_tareas_tarea_view_search" model="ir.ui.view">
        <field name="name">gestion_tareas.tarea.search</field>
        <field name="model">gestion_tareas.tarea</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <filter name="filter_pendientes" string="Pendientes"
                    domain="[('state', '=', 'pendiente')]" />
                <filter name="filter_finalizadas" string="Finalizadas"
                    domain="[('state', '=', 'finalizada')]" />
                <separator />
                <filter name="group_by_partner" string="Cliente"
                    context="{'group_by': 'partner_id'}" />
            </search>
        </field>
    </record>
    <!-- Acción de ventana -->
    <record id="gestion_tareas_tarea_action" model="ir.actions.act_window">
        <field name="name">Tareas</field>
        <field name="res_model">gestion_tareas.tarea</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra la primera tarea sobre un cliente</p>
        </field>
    </record>
    <!-- Menús -->
    <menuitem id="gestion_tareas_menu_root" name="Gestión de tareas" sequence="20" />
    <menuitem id="gestion_tareas_menu_tareas" name="Tareas" parent="gestion_tareas_menu_root"
        action="gestion_tareas_tarea_action" sequence="10" />
</odoo>